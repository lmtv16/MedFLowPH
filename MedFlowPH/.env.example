# MedFlow PH API (copy to /etc/medflow/api.env or systemd EnvironmentFile)
# Comma-separated SPA origins for split deploy (merged with localhost dev defaults)
# MEDFLOW_CORS_ORIGINS=https://medflow.example.com,https://www.medflow.example.com

# Public demo: reject CSV/ZIP uploads (Quick + bundled still work)
# MEDFLOW_DISABLE_UPLOAD=true
